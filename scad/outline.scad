// Even-odd fill: a loop inside another loop is a hole.
module loops(l) polygon([for (loop = l) each loop], _paths(l));
function _paths(l, i = 0, n = 0) = i == len(l) ? []
    : concat([[for (j = [0:len(l[i]) - 1]) n + j]], _paths(l, i + 1, n + len(l[i])));

